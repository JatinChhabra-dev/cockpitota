# Secrets & local environment (keep .env.example tracked)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Node / React Console
console/node_modules/
console/dist/
console/.vite/
console/*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Android / Kotlin local build artifacts & signing keys
apps/.build_tmp/
apps/dist/*.jks
apps/dist/*.keystore
apps/dist/*.apk.idsig
*.hprof

# Runtime evidence & test outputs
evidence/screenshots/
evidence/traces/
evidence/runs/
evidence/diffs/
evidence/gates/
evidence/dossiers/
evidence/ota_ledger.json
evidence/ai_records.json
signals/scenarios/imported_can_test.yaml

# Logs, temp files, OS & IDE
*.log
*.tmp
.DS_Store
Thumbs.db
.vscode/
.idea/
